rules_version = '2';

// SEC-02：画面（クライアント）は Firestore に直接触れない。読み書きはすべて拒否する。
// バックエンドはサービスアカウント（cloud-run-vertex-sa、roles/datastore.user）で
// 読み書きし、サーバーのライブラリはこのルールの対象外。
// 置き方と確かめ方は backend/README.md の「本番（MODE=live）」を見る。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
